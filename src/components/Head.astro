---
import "../styles/global.css";
import { site } from "../config/site.mjs";
import { marketMeta, marketOf, type Market } from "../i18n/ui";
import { isoDate } from "../lib/dates";
import { pagePath } from "../lib/paths";

export interface SeoProps {
  title: string;
  description: string;
  /** Last-modified date; also read by the sitemap for lastmod. */
  updated: Date;
  published?: Date;
  type?: "website" | "article";
  noindex?: boolean;
  /** Paths of this page in each market it exists in (regional equivalents only), itself included. Omit when there are none. */
  alternates?: Partial<Record<Market, string>>;
  /** Absolute or root-relative social image; defaults to /og-default.png. */
  image?: string;
}

const { title, description, updated, published, type = "website", noindex = false, alternates, image } = Astro.props as SeoProps;
const path = pagePath(Astro.url.pathname);
const canonical = new URL(path, site.url).href;
const market = marketOf(path);
// Every market version lists all versions, itself included; x-default is the US English one.
const versions = Object.entries(alternates ?? { [market]: path }) as [Market, string][];
const xDefault = alternates?.us ?? path;
const suffixed = `${title} | ${site.name}`;
const fullTitle = path === "/" || title.includes(site.name) || suffixed.length > 60 ? title : suffixed;
const ogImage = new URL(image ?? "/og-default.png", site.url).href;
const robots = noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

if (fullTitle.length > 60) throw new Error(`Title over 60 chars on ${path}: "${fullTitle}"`);
if (description.length > 155) throw new Error(`Description over 155 chars on ${path}`);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Mona Sans (one variable file for every weight): preloaded so text renders in it without a fallback flash. -->
<link rel="preload" href="/fonts/Mona-Sans.woff2" as="font" type="font/woff2" crossorigin />
<meta name="theme-color" content="#212830" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/icon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/icon-180.png" />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
{versions.map(([code, p]) => <link rel="alternate" hreflang={marketMeta[code].hreflang} href={new URL(p, site.url).href} />)}
<link rel="alternate" hreflang="x-default" href={new URL(xDefault, site.url).href} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={marketMeta[market].og} />
{versions.filter(([code]) => code !== market).map(([code]) => <meta property="og:locale:alternate" content={marketMeta[code].og} />)}
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={image ? title : site.name} />
<meta property="og:updated_time" content={updated.toISOString()} />
{type === "article" && published && <meta property="article:published_time" content={isoDate(published)} />}
{type === "article" && <meta property="article:modified_time" content={isoDate(updated)} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- PageFind -->
<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>

<script is:inline>
  // Lets the CSS show content immediately; no theme switching or page transitions.
  document.documentElement.classList.add("js");
</script>
