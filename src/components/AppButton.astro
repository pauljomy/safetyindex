---
// The one app button (brief section 15). Only on pages with a checklist, only in `app_markets`.
// While `apps_live` is false: a plain, non-clickable "coming soon" note (no store badges).
// With real IDs and `apps_live: true` in scripts/config.yml: official, unmodified store badges,
// device detection (Android → Google Play, iPhone/iPad → App Store, desktop → both + a QR code
// to /get-app/?c=<checklist>), no other code changes.
import QRCode from "qrcode";
import { config } from "../../scripts/lib/config.mjs";
import { appLinks } from "@lib/app";
import { langOf, marketOf, ui } from "../i18n/ui";
const { checklistId } = Astro.props as { checklistId: string };
const path = Astro.url.pathname;
const market = marketOf(path);
const s = ui[langOf(path)];
const show = (config.app_markets as string[]).includes(market);
const links = appLinks(market, checklistId);
const qr = config.apps_live ? await QRCode.toString(links.redirect, { type: "svg", margin: 1, width: 120 }) : "";
---
{show && (
  config.apps_live ? (
    <div class="not-prose my-6 flex flex-wrap items-center gap-4 print:hidden" data-app-button data-market={market} data-checklist={checklistId}>
      <span class="font-medium">{s.appGet}</span>
      <a href={links.play} data-store="play" rel="noopener" data-track="store_click"><img src="/badges/google-play.png" alt="Get it on Google Play" height="48" width="161" /></a>
      <a href={links.appStore} data-store="appstore" rel="noopener" data-track="store_click"><img src="/badges/app-store.svg" alt="Download on the App Store" height="48" width="144" /></a>
      <figure class="hidden md:block" data-desktop-only><Fragment set:html={qr} /><figcaption class="text-xs">{s.appScan}</figcaption></figure>
    </div>
    <script>
      const ua = navigator.userAgent;
      const isAndroid = /Android/i.test(ua);
      const isIos = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
      document.querySelectorAll<HTMLElement>("[data-app-button]").forEach((el) => {
        if (isAndroid) el.querySelector<HTMLElement>('[data-store="appstore"]')?.remove();
        if (isIos) el.querySelector<HTMLElement>('[data-store="play"]')?.remove();
        if (isAndroid || isIos) el.querySelector("[data-desktop-only]")?.remove();
      });
    </script>
  ) : (
    <p class="my-3 flex items-center gap-2 text-[14px] text-muted print:hidden" data-app-button data-app-soon><svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 fill-current"><path d="M3.75 0h8.5C13.216 0 14 .784 14 1.75v12.5A1.75 1.75 0 0 1 12.25 16h-8.5A1.75 1.75 0 0 1 2 14.25V1.75C2 .784 2.784 0 3.75 0ZM3.5 1.75v12.5c0 .138.112.25.25.25h8.5a.25.25 0 0 0 .25-.25V1.75a.25.25 0 0 0-.25-.25h-8.5a.25.25 0 0 0-.25.25ZM8 13a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/></svg><span><span class="font-semibold text-ink">{s.appGet}:</span>{" "}{s.appComingSoon}</span></p>
  )
)}
