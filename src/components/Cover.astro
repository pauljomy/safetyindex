---
// The one cover-image component: a guide's own coverImage, or a shared subject
// image in src/assets/covers/<subject>.webp. Renders nothing until the image exists.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { coverFor } from "@lib/covers";
const { image, subject, alt } = Astro.props as { image?: ImageMetadata; subject?: string; alt?: string };
const src = image ?? coverFor(subject);
---
{src && alt && (
  <figure class="animate not-prose -mt-4 mb-10">
    <Image src={src} alt={alt} widths={[480, 768, 1200]} sizes="(max-width: 640px) 100vw, 640px" loading="eager" fetchpriority="high" class="w-full rounded-lg border border-black/15 dark:border-white/20" />
  </figure>
)}
