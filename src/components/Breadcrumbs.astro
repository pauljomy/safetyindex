---
// Visible breadcrumb trail (Home → market → hub → page). The same list feeds BreadcrumbList JSON-LD in the view.
// Sits on the dark page band.
import type { Crumb } from "@lib/schema";
import { langOf, ui } from "../i18n/ui";
const { crumbs } = Astro.props as { crumbs: Crumb[] };
const s = ui[langOf(Astro.url.pathname)];
---
<nav aria-label={s.breadcrumb} class="text-[13px] text-white/70" data-pagefind-ignore>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true" class="text-white/40">/</span>}
        {i < crumbs.length - 1 ? <a href={c.href} class="hover:text-white hover:underline">{c.label}</a> : <span aria-current="page" class="line-clamp-1 text-white/90">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>
