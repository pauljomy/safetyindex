---
// "Related" block: 3–6 links in the same market, picked by shared clauses, industries and topic.
import { relatedPages } from "@lib/content";
import { langOf, ui } from "../i18n/ui";
import { pagePath } from "@lib/paths";
import Card from "@components/Card.astro";
const { exclude = [], title, variant = "list" } = Astro.props as { exclude?: string[]; title?: string; variant?: "list" | "grid" };
const path = pagePath(Astro.url.pathname);
const s = ui[langOf(path)];
const pages = await relatedPages(path, { exclude });
---
{pages.length > 0 && (variant === "grid" ? (
  <section class="mt-20" data-pagefind-ignore data-related>
    <h2 class="rule-top section-title"><span>{title ?? s.related}</span></h2>
    <div class="grid gap-x-12 md:grid-cols-2">{pages.map((p) => <Card item={{ path: p.path, title: p.title, description: p.description, image: p.image, label: p.label }} />)}</div>
  </section>
) : (
  <section data-pagefind-ignore data-related>
    <h2 class="border-b pb-2 text-[17px] font-semibold">{title ?? s.related}</h2>
    {pages.map((p) => <Card item={{ path: p.path, title: p.title, description: p.description }} variant="compact" />)}
  </section>
))}
