---
// Dark two-row header (github.blog pattern): brand + main sections + search + language, then a row of
// topics that leads straight to groups of standard pages. Only sections with live pages are shown.
import { site } from "../config/site.mjs";
import { inLang, langOf, langs, meta, ui, type Market } from "../i18n/ui";
import { marketHubs, url, livePages } from "@lib/content";
import { standardTopics } from "../data/topics.mjs";

const { alternates } = Astro.props as { alternates?: Partial<Record<Market, string>> };
const lang = langOf(Astro.url.pathname);
const s = ui[lang];
const market: Market = lang === "en" ? "us" : (lang as Market);
const hubs = await marketHubs(market);
const live = await livePages();
const topics = lang === "en" ? standardTopics.filter((t) => live.some((p) => p.topic === t.slug)) : [];
const here = Astro.url.pathname.replace(/\.html$/, "");
---
<header class="bg-band text-white print-hide" data-pagefind-ignore>
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:text-ink">{s.skip}</a>
  <div class="wrap flex h-[78px] items-center gap-10">
    <a href={inLang("/", lang)} class="flex shrink-0 items-center gap-2.5 text-[20px] font-bold tracking-[-0.02em]">
      <img src="/icon.svg" alt="" width="28" height="28" class="rounded" />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main" class="hidden items-center gap-9 text-[15px] font-medium lg:flex">
      {hubs.map((h) => <a href={h.path} class:list={["text-white/90 hover:text-white", here.startsWith(h.path) && "text-white underline underline-offset-8"]}>{h.label}</a>)}
      <a href={inLang("/about", lang)} class="text-white/90 hover:text-white">{s.about[0].toUpperCase() + s.about.slice(1)}</a>
    </nav>
    <div class="ml-auto flex items-center gap-3">
      <button id="magnifying-glass" aria-label={s.search} class="flex size-9 items-center justify-center rounded-md text-white/90 hover:bg-white/10 hover:text-white">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3.5 7a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0ZM9.97 11.03A5 5 0 1 1 11.03 9.97l3 3-1.06 1.06-3-3Z"/></svg>
      </button>
      <span class="hidden items-center gap-1 rounded-md border border-white/25 p-0.5 text-[13px] font-semibold sm:flex" aria-label={s.language}>
        {langs.map((l) => l === lang
          ? <span class="rounded bg-white px-2 py-1 text-ink" aria-current="true">{l.toUpperCase()}</span>
          : <a href={alternates?.[l === "en" ? "us" : l] ?? inLang("/", l)} hreflang={meta[l].hreflang} lang={meta[l].hreflang} title={meta[l].label} class="rounded px-2 py-1 text-white/85 hover:bg-white/10 hover:text-white">{l.toUpperCase()}</a>)}
      </span>
      <details class="relative lg:hidden">
        <summary class="flex size-9 cursor-pointer list-none items-center justify-center rounded-md hover:bg-white/10" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1 2.75A.75.75 0 0 1 1.75 2h12.5a.75.75 0 0 1 0 1.5H1.75A.75.75 0 0 1 1 2.75Zm0 5A.75.75 0 0 1 1.75 7h12.5a.75.75 0 0 1 0 1.5H1.75A.75.75 0 0 1 1 7.75ZM1.75 12h12.5a.75.75 0 0 1 0 1.5H1.75a.75.75 0 0 1 0-1.5Z"/></svg>
        </summary>
        <nav aria-label="Menu" class="absolute right-0 top-11 z-40 w-64 rounded-lg border border-white/15 bg-band p-2 shadow-2xl">
          {hubs.map((h) => <a href={h.path} class="block rounded px-3 py-2 text-[15px] hover:bg-white/10">{h.label}</a>)}
          <a href={inLang("/about", lang)} class="block rounded px-3 py-2 text-[15px] hover:bg-white/10">{s.about[0].toUpperCase() + s.about.slice(1)}</a>
          <div class="mt-2 flex gap-1 border-t border-white/15 px-3 pt-3 text-[13px] sm:hidden">
            {langs.map((l) => <a href={alternates?.[l === "en" ? "us" : l] ?? inLang("/", l)} class:list={["rounded px-2 py-1", l === lang ? "bg-white text-ink" : "hover:bg-white/10"]}>{l.toUpperCase()}</a>)}
          </div>
        </nav>
      </details>
    </div>
  </div>
  {topics.length > 0 && (
    <div class="border-t border-white/10 border-b border-b-white/10">
      <nav aria-label="Topics" class="wrap flex gap-8 overflow-x-auto py-[18px] text-[14px] font-semibold whitespace-nowrap [scrollbar-width:none] xl:justify-between">
        {topics.map((t) => <a href={`${url.standardsHub()}#${t.slug}`} class="text-white/85 hover:text-white">{t.name}</a>)}
      </nav>
    </div>
  )}
</header>
