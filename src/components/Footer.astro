---
// Light footer with the site's sections, countries and company links (github.blog-style columns).
import { site } from "../config/site.mjs";
import { inLang, langOf, marketMeta, ui, type Market } from "../i18n/ui";
import { liveMarkets, marketHubs, url } from "@lib/content";

const lang = langOf(Astro.url.pathname);
const s = ui[lang];
const market: Market = lang === "en" ? "us" : (lang as Market);
const hubs = await marketHubs(market);
const markets = (await liveMarkets()).filter((m) => m !== market);
---
<footer class="mt-24 border-t bg-subtle print-hide" data-pagefind-ignore>
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="space-y-3">
      <a href={inLang("/", lang)} class="flex items-center gap-2 text-lg font-bold"><img src="/icon.svg" alt="" width="24" height="24" class="rounded" />{site.name}</a>
      <p class="max-w-xs text-sm text-muted">{s.madeBy}</p>
    </div>
    <nav aria-label="Sections" class="space-y-2 text-sm">
      <p class="font-semibold text-ink">{s.blog[0].toUpperCase() + s.blog.slice(1)}</p>
      {hubs.map((h) => <a href={h.path} class="block text-muted hover:text-ink">{h.label}</a>)}
      <a href={url.blog(lang)} class="block text-muted hover:text-ink">{s.blogTitle}</a>
      <a href={url.tags(lang)} class="block text-muted hover:text-ink">{s.allTags}</a>
    </nav>
    <nav aria-label="Countries" class="space-y-2 text-sm">
      <p class="font-semibold text-ink">{s.language}</p>
      {markets.map((m) => <a href={url.market(m)} class="block text-muted hover:text-ink">{marketMeta[m].name}</a>)}
    </nav>
    <nav aria-label="Footer" class="space-y-2 text-sm">
      <p class="font-semibold text-ink">{site.name}</p>
      <a href={inLang("/about", lang)} class="block text-muted hover:text-ink">{s.aboutTitle}</a>
      <a href="/contact" class="block text-muted hover:text-ink">{s.contact}</a>
      <a href="/privacy" class="block text-muted hover:text-ink">{s.privacy}</a>
      <a href="/terms" class="block text-muted hover:text-ink">{s.terms}</a>
      <a href="/rss.xml" class="block text-muted hover:text-ink">{s.rss}</a>
      <a href="/llms.txt" class="block text-muted hover:text-ink">llms.txt</a>
    </nav>
  </div>
  <div class="border-t">
    <div class="wrap flex flex-wrap justify-between gap-2 py-5 text-xs text-muted">
      <span>&copy; {new Date().getFullYear()} {site.name}</span>
      <span>{s.disclaimer}</span>
    </div>
  </div>
</footer>
