---
// Hub page (brief section 8): a table linking every live page in the group, grouped by topic.
// Built only when the group has at least one live page.
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import type { Crumb } from "@lib/schema";
import { breadcrumbList } from "@lib/schema";
import type { Market } from "../i18n/ui";

export interface HubRow { path: string; title: string; description?: string; extra?: string }
export interface HubGroup { heading: string; rows: HubRow[] }
const { title, description, intro, crumbs, groups, extraHeader, updated, alternates, featured = [] } = Astro.props as {
  title: string; description: string; intro: string; crumbs: Crumb[]; groups: HubGroup[]; extraHeader?: string; updated: Date;
  alternates?: Partial<Record<Market, string>>; featured?: HubRow[];
};
---
<Layout title={title} description={description} updated={updated} alternates={alternates} jsonLd={[breadcrumbList(crumbs)]}>
  <Container>
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="animate mb-4 text-2xl font-semibold text-black dark:text-white">{title}</h1>
    <p class="animate mb-8">{intro}</p>
    {featured.length > 0 && (
      <ul class="animate not-prose mb-10 space-y-2" data-featured>
        {featured.map((f) => <li><a href={f.path} class="font-medium underline decoration-black/30 underline-offset-2">{f.title}</a>{f.description && <span class="block text-sm">{f.description}</span>}</li>)}
      </ul>
    )}
    <div class="animate space-y-10" data-hub>
      {groups.map((g) => (
        <section>
          <h2 class="mb-3 font-semibold text-black dark:text-white">{g.heading}</h2>
          <table class="w-full text-sm">
            <thead><tr><th class="text-left">Page</th>{extraHeader && <th class="text-right">{extraHeader}</th>}</tr></thead>
            <tbody>
              {g.rows.map((r) => (
                <tr>
                  <td class="py-1.5 pr-4"><a href={r.path} class="font-medium">{r.title}</a>{r.description && <span class="block">{r.description}</span>}</td>
                  {extraHeader && <td class="py-1.5 text-right whitespace-nowrap">{r.extra}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))}
    </div>
  </Container>
</Layout>
