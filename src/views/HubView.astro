---
// Hub page (brief section 8): every live page in the group, grouped by topic, as image cards.
// Each group has an anchor (#slug) so the header's topic row and the home page can link to it.
import Layout from "@layouts/Layout.astro";
import PageBand from "@components/PageBand.astro";
import Card, { type CardData } from "@components/Card.astro";
import type { Crumb } from "@lib/schema";
import { breadcrumbList } from "@lib/schema";
import { slugify } from "@lib/slugify";
import type { Market } from "../i18n/ui";

export interface HubRow extends CardData {}
export interface HubGroup { heading: string; slug?: string; rows: HubRow[] }
const { title, description, intro, crumbs, groups, updated, alternates, featured = [], jump = true } = Astro.props as {
  title: string; description: string; intro: string; crumbs: Crumb[]; groups: HubGroup[]; extraHeader?: string; updated: Date;
  alternates?: Partial<Record<Market, string>>; featured?: HubRow[]; jump?: boolean;
};
const anchored = groups.map((g) => ({ ...g, slug: g.slug ?? slugify(g.heading) }));
---
<Layout title={title} description={description} updated={updated} alternates={alternates} jsonLd={[breadcrumbList(crumbs)]}>
  <PageBand crumbs={crumbs} title={title} subtitle={intro}>
    {jump && anchored.length > 2 && (
      <nav aria-label="Sections" class="mt-8 flex flex-wrap gap-2">
        {anchored.map((g) => <a href={`#${g.slug}`} class="rounded-full border border-white/25 px-3 py-1 text-[13px] font-semibold text-white/85 hover:border-white hover:text-white">{g.heading} <span class="font-mono text-white/50">{g.rows.length}</span></a>)}
      </nav>
    )}
  </PageBand>
  <div class="wrap">
    <div class="mx-auto max-w-[1040px]" data-hub>
      {featured.length > 0 && <div class="mt-10 grid gap-x-12 md:grid-cols-2">{featured.map((f) => <Card item={f} />)}</div>}
      {anchored.map((g) => (
        <section id={g.slug} class="mt-14 scroll-mt-6">
          <h2 class="rule-top section-title"><span>{g.heading}</span><span class="meta">{g.rows.length}</span></h2>
          <div class="grid gap-x-12 md:grid-cols-2">{g.rows.map((r) => <Card item={r} />)}</div>
        </section>
      ))}
    </div>
  </div>
</Layout>
