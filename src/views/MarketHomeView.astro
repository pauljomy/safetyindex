---
// Market home (/us, /uk, /au, /ca, /nz): links every hub of the market, plus the reports for the US.
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { livePages, marketHubs, url } from "@lib/content";
import { latest } from "@lib/dates";
import { breadcrumbList } from "@lib/schema";
import { marketMeta, ui, type Market } from "../i18n/ui";
import { site } from "../config/site.mjs";

const { market } = Astro.props as { market: Market };
const s = ui.en;
const name = marketMeta[market].name;
const inText = marketMeta[market].inText;
const hubs = await marketHubs(market);
const pages = (await livePages()).filter((p) => p.market === market);
const reports = pages.filter((p) => p.kind === "report");
const latestGuides = pages.filter((p) => p.kind === "guide").sort((a, b) => b.released.getTime() - a.released.getTime()).slice(0, 6);
const crumbs = [{ label: s.home, href: "/" }, { label: name, href: url.market(market) }];
const updated = latest(site.updated, ...pages.map((p) => p.updated));
import PageBand from "@components/PageBand.astro";
import Card from "@components/Card.astro";
---
<Layout title={s.marketHomeTitle(inText)} description={s.marketHomeDescription(inText)} updated={updated} jsonLd={[breadcrumbList(crumbs)]}>
  <PageBand crumbs={crumbs} title={s.marketHomeTitle(inText)} subtitle={s.marketHomeDescription(inText)} />
  <Container wide>
    <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-hubs>
      {hubs.map((h) => <li><a href={h.path} class="flex h-full items-center justify-between rounded-md border px-5 py-5 text-[17px] font-semibold hover:border-ink">{h.label}<span class="meta">{h.count}</span></a></li>)}
    </ul>
    {reports.length > 0 && (
      <section class="mt-14">
        <h2 class="rule-top section-title"><span>{s.hubReports}</span></h2>
        <div class="grid gap-x-12 md:grid-cols-2">{reports.map((r) => <Card item={{ path: r.path, title: r.title, description: r.description, image: r.image, label: r.label, date: r.released }} />)}</div>
      </section>
    )}
    {latestGuides.length > 0 && (
      <section class="mt-14">
        <h2 class="rule-top section-title"><span>{s.latest}</span></h2>
        <div class="grid gap-x-12 md:grid-cols-2">{latestGuides.map((r) => <Card item={{ path: r.path, title: r.title, description: r.description, image: r.image, label: r.label, date: r.released }} />)}</div>
      </section>
    )}
  </Container>
</Layout>
