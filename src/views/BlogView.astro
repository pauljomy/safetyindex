---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { categoryName, getPosts, hubAlternates, url } from "@lib/content";
import { categories } from "../data/categories.mjs";
import { latest } from "@lib/dates";
import { breadcrumbList } from "@lib/schema";
import { inLang, ui, type Lang } from "../i18n/ui";
import { site } from "../config/site.mjs";

const { lang } = Astro.props as { lang: Lang };
const s = ui[lang];
const posts = await getPosts(lang);
// The language's guides hub: every guide, grouped by topic (category), newest first within a topic.
const groups = categories.map((c) => ({ slug: c.slug, name: categoryName(c.slug, lang), posts: posts.filter((p) => p.data.categories[0] === c.slug) })).filter((g) => g.posts.length);
const crumbs = [{ label: s.home, href: inLang("/", lang) }, { label: s.blog, href: url.blog(lang) }];
---

<Layout
  title={s.blogTitle}
  description={s.blogDescription}
  updated={latest(site.updated, ...posts.map((p) => latest(p.data.date, p.data.updated)))}
  alternates={hubAlternates("/blog")}
  jsonLd={[breadcrumbList(crumbs)]}
>
  <Container>
    <Breadcrumbs crumbs={crumbs} />
    <aside data-pagefind-ignore>
      <h1 class="animate mb-8 font-semibold text-black dark:text-white">{s.blogTitle}</h1>
      <div class="space-y-10">
        {
          groups.map((g) => (
            <section class="animate space-y-4">
              <h2 class="font-semibold text-black dark:text-white"><a href={url.category(g.slug, lang)}>{g.name}</a></h2>
              <ul class="not-prose flex flex-col gap-4">{g.posts.map((p) => <li><ArrowCard entry={p} /></li>)}</ul>
            </section>
          ))
        }
        {posts.length === 0 && <p>{s.noPosts}</p>}
      </div>
    </aside>
  </Container>
</Layout>
