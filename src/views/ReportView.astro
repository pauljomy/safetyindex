---
// Yearly data report (brief sections 7g and 7h): a quotable one-sentence summary, static SVG
// charts, tables (downloadable as CSV and Excel), the method, data source, sample size and
// update date. Built by script from public data; no writer involved.
import Layout from "@layouts/Layout.astro";
import ArticleFrame from "@components/ArticleFrame.astro";
import BarChart from "@components/BarChart.astro";
import PageNotes from "@components/PageNotes.astro";
import { getIndustries, standardFor, url, type Report } from "@lib/content";
import { formatDate, latest } from "@lib/dates";
import { withLinks } from "@lib/links";
import { escapeHtml } from "@lib/linker.mjs";
import { coverFor, socialCard } from "@lib/covers";
import { breadcrumbList, webPage } from "@lib/schema";
import { ui } from "../i18n/ui";

interface Cell { text?: string; html?: string; href?: string; section?: string; naics?: string }
interface Section { heading: string; opening: string; chart?: { title: string; data: { label: string; value: number }[]; unit?: "usd" | "n" }; table?: { columns: string[]; rows: (string | number | Cell)[][]; download?: string }; note?: string }
const { entry } = Astro.props as { entry: Report };
const d = entry.data;
const s = ui.en;
const path = url.report(entry.id);
const data = d.data as { sections: Section[]; sampleSize: string; dataYear: string; downloads: { label: string; file: string }[] };
const used = new Set<string>();
const link = async (t: string) => withLinks(escapeHtml(t), path, used);
const summary = await link(d.summary);
const sections = [];
for (const sec of data.sections) sections.push({ ...sec, opening: await link(sec.opening) });
// Table cells naming a standard or an industry link to its page once that page is live.
const industries = await getIndustries();
for (const sec of sections) for (const row of sec.table?.rows ?? []) for (const c of row) if (c && typeof c === "object" && !c.href) {
  if (c.section) c.href = (await standardFor(c.section))?.path;
  else if (c.naics) { const i = industries.find((x) => x.data.naics === c.naics && !x.data.noindex); if (i) c.href = url.industry(i.id); }
}
// Plain-text cells get the same generated links as the prose (first mention of a live standard page links to it).
for (const sec of sections) if (sec.table) sec.table.rows = await Promise.all(sec.table.rows.map((row) => Promise.all(row.map(async (c) => (typeof c === "string" ? { html: await withLinks(escapeHtml(c), path, used) } : c)))));
const og = await socialCard(coverFor(d.cover));
const crumbs = [{ label: s.home, href: "/" }, { label: "United States", href: url.market("us") }, { label: s.hubReports, href: url.reportsHub() }, { label: d.title, href: path }];
const updated = latest(d.date, d.updated);
const fmt = (unit?: string) => (n: number) => (unit === "usd" ? `$${n.toLocaleString("en-US")}` : n.toLocaleString("en-US"));
const cell = (c: string | number | Cell) => (typeof c === "object" ? c : { text: typeof c === "number" ? c.toLocaleString("en-US") : c });
---
<Layout notes={false} title={d.seoTitle} description={d.description} published={d.date} updated={updated} type="article" image={og} noindex={d.noindex}
  jsonLd={[webPage({ path, title: d.title, description: d.description, date: d.date, updated: d.updated, image: og, lang: "en-US" }), breadcrumbList(crumbs)]}>
  <ArticleFrame crumbs={crumbs} title={d.title} label="Data report" image={coverFor(d.cover)} alt={d.coverAlt} meta={[`Updated ${formatDate(updated)}`, `Data: ${data.dataYear}`, `Sample: ${data.sampleSize}`]} toc={[...sections.map((sec, i) => ({ depth: 2, slug: `s${i + 1}`, text: sec.heading })), { depth: 2, slug: "method", text: "How this report was made" }, { depth: 2, slug: "sources", text: s.sources }]}>
    <article class="article" data-pagefind-body>
      <p data-answer class="lead"><Fragment set:html={summary} /></p>
      {data.downloads.length > 0 && (
        <p class="flex flex-wrap gap-2 text-sm print:hidden">
          {data.downloads.map((f) => <a class="chip no-underline" href={f.file} download data-track={f.file.endsWith(".csv") ? "download_csv" : "download_xlsx"}>{f.label}</a>)}
        </p>
      )}
      {sections.map((sec, i) => (
        <>
          <h2 id={`s${i + 1}`}>{sec.heading}</h2>
          <p><Fragment set:html={sec.opening} /></p>
          {sec.chart && <BarChart title={sec.chart.title} data={sec.chart.data} format={fmt(sec.chart.unit)} />}
          {sec.table && (
            <table>
              <thead><tr>{sec.table.columns.map((c) => <th>{c}</th>)}</tr></thead>
              <tbody>{sec.table.rows.map((r) => <tr>{r.map((c) => { const x = cell(c); return <td>{x.html ? <Fragment set:html={x.html} /> : x.href ? <a href={x.href}>{x.text}</a> : x.text}</td>; })}</tr>)}</tbody>
            </table>
          )}
          {sec.note && <p class="text-sm">{sec.note}</p>}
        </>
      ))}
      <h2 id="method">How this report was made</h2>
      <p>{d.method}</p>
      <h2 id="sources">{s.sources}</h2>
      <ul>{d.sources.map((src) => <li><a href={src.url} rel="noopener">{src.title}</a></li>)}</ul>
      <PageNotes dataAsOf={d.dataAsOf ?? updated} sources={d.sources} data />
    </article>
  </ArticleFrame>
</Layout>
