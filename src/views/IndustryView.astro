---
// US industry page (brief section 7c): most-cited standards (ranked, with counts), most-cited
// paragraphs, penalty patterns, links to each standard page. No standard × industry pages.
import Layout from "@layouts/Layout.astro";
import ArticleFrame from "@components/ArticleFrame.astro";
import BarChart from "@components/BarChart.astro";
import PageNotes from "@components/PageNotes.astro";
import { formatDate } from "@lib/dates";
import { standardFor, url, type Industry } from "@lib/content";
import { latest } from "@lib/dates";
import { withLinks } from "@lib/links";
import { escapeHtml } from "@lib/linker.mjs";
import { coverFor, socialCard } from "@lib/covers";
import { breadcrumbList, faqPage, webPage } from "@lib/schema";
import { ui } from "../i18n/ui";

const { entry } = Astro.props as { entry: Industry };
const d = entry.data;
const s = ui.en;
const st = d.stats;
const path = url.industry(entry.id);
const span = `FY${st.fiscalYears[0]}–FY${st.fiscalYears.at(-1)}`;
const usd = (n: number | null) => (n == null ? "–" : `$${n.toLocaleString("en-US")}`);
const pct = (x: number) => `${Math.round(x * 100)}%`;
const used = new Set<string>();
const link = async (t: string) => withLinks(escapeHtml(t), path, used);
const standards = [];
for (const r of st.topStandards.slice(0, 15)) {
  const page = await standardFor(String(r.section));
  standards.push({ section: String(r.section), count: Number(r.count), page, note: d.standardNotes.find((n) => n.section === r.section)?.note });
}
// Paragraph cells link to the standard's own page when it's live.
const paragraphLinks = await Promise.all(st.topParagraphs.map(async (p) => (await standardFor(String(p.clause).match(/^19\d\d\.\d+[a-z]?/)?.[0] ?? ""))?.path));
const og = await socialCard(coverFor(d.cover));
const crumbs = [{ label: s.home, href: "/" }, { label: "United States", href: url.market("us") }, { label: s.hubIndustries, href: url.industriesHub() }, { label: d.title, href: path }];
const opening = await link(d.opening);
const patterns = await link(d.patternsSummary);
const penaltiesText = await link(d.penaltiesSummary);
const faqHtml = await Promise.all(d.faq.map((f) => link(f.answer)));
const updated = latest(d.date, d.updated);
---
<Layout notes={false} title={d.seoTitle} description={d.description} published={d.date} updated={updated} type="article" noindex={d.noindex} image={og}
  jsonLd={[webPage({ path, title: d.title, description: d.description, date: d.date, updated: d.updated, image: og, lang: "en-US", about: `NAICS ${d.naics} ${d.naicsTitle}` }), breadcrumbList(crumbs), ...(d.faq.length ? [faqPage(d.faq)] : [])]}>
  <ArticleFrame crumbs={crumbs} title={d.title} subtitle={`NAICS ${d.naics}: ${d.naicsTitle}`} label="Industry" image={coverFor(d.cover)} alt={d.coverAlt} meta={[formatDate(d.date), `Data ${span}`, `${st.inspections.toLocaleString("en-US")} inspections`]} toc={[{ depth: 2, slug: "standards", text: "Most-cited standards" }, { depth: 2, slug: "paragraphs", text: "Most-cited paragraphs" }, { depth: 2, slug: "penalties", text: "Penalties" }, { depth: 2, slug: "sources", text: s.sources }]} relatedExclude={standards.flatMap((x) => (x.page ? [x.page.path] : []))}>
    <article class="article" data-pagefind-body>
      <p data-answer class="lead"><Fragment set:html={opening} /></p>
      <h2 id="standards">Which OSHA standards are cited most in this industry?</h2>
      <p>Federal and state OSHA inspectors opened {st.inspections.toLocaleString("en-US")} inspections in NAICS {d.naics} in {span} and issued {st.citations.toLocaleString("en-US")} citations under 29 CFR standards.</p>
      <p><Fragment set:html={patterns} /></p>
      <BarChart title={`Most-cited OSHA standards in NAICS ${d.naics}, ${span}`} data={standards.slice(0, 10).map((x) => ({ label: x.section, value: x.count }))} />
      <table>
        <thead><tr><th>Rank</th><th>Standard</th><th>Citations</th></tr></thead>
        <tbody>{standards.map((x, i) => <tr><td>{i + 1}</td><td>{x.page ? <a href={x.page.path}>{x.page.title}</a> : `29 CFR ${x.section}`}{x.note && <span class="block text-sm">{x.note}</span>}</td><td>{x.count.toLocaleString("en-US")}</td></tr>)}</tbody>
      </table>
      {st.topParagraphs.length > 0 && (
        <>
          <h2 id="paragraphs">Which paragraphs are cited most in this industry?</h2>
          <p>The single most-cited paragraph in NAICS {d.naics} in {span} was {st.topParagraphs[0].clause}, with {Number(st.topParagraphs[0].count).toLocaleString("en-US")} citations.</p>
          <table>
            <thead><tr><th>Paragraph</th><th>Citations</th></tr></thead>
            <tbody>{st.topParagraphs.map((p, i) => <tr><td>{paragraphLinks[i] ? <a href={paragraphLinks[i]}>{p.clause}</a> : p.clause}</td><td>{Number(p.count).toLocaleString("en-US")}</td></tr>)}</tbody>
          </table>
        </>
      )}
      <h2 id="penalties">What penalties does OSHA propose in this industry?</h2>
      <p>The median initial penalty for a cited item with a penalty in NAICS {d.naics} was {usd(st.penalties.median)} in {span}, with the middle half between {usd(st.penalties.p25)} and {usd(st.penalties.p75)}. Penalties can be reduced on settlement or after a contest.</p>
      <p><Fragment set:html={penaltiesText} /></p>
      <table>
        <thead><tr><th>Classification</th><th>Share of citations</th></tr></thead>
        <tbody>
          <tr><td>Serious</td><td>{pct(st.typeShares.serious)}</td></tr>
          <tr><td>Willful</td><td>{pct(st.typeShares.willful)}</td></tr>
          <tr><td>Repeat</td><td>{pct(st.typeShares.repeat)}</td></tr>
          <tr><td>Other-than-serious</td><td>{pct(st.typeShares.otherThanSerious)}</td></tr>
        </tbody>
      </table>
      <p>See <a href={url.penalties()}>current maximum OSHA penalties</a> for the federal ceilings.</p>
      {d.faq.length > 0 && (<><h2>{s.faq}</h2>{d.faq.map((f, i) => (<><h3>{f.question}</h3><p><Fragment set:html={faqHtml[i]} /></p></>))}</>)}
      <h2 id="sources">{s.sources}</h2>
      <ul>{d.sources.map((src) => <li><a href={src.url} rel="noopener">{src.title}</a></li>)}</ul>
      <p class="text-sm">Enforcement data: U.S. Department of Labor OSHA inspection and violation datasets, {span}. Industry titles: NAICS 2022, U.S. Census Bureau.</p>
      <PageNotes dataAsOf={d.dataAsOf ?? updated} sources={d.sources} />
    </article>
  </ArticleFrame>
</Layout>
