---
import Layout from "@layouts/Layout.astro";
import ArticleFrame from "@components/ArticleFrame.astro";
import ChecklistBlock from "@components/ChecklistBlock.astro";
import PageNotes from "@components/PageNotes.astro";
import { categoryName, getChecklist, postAlternates, postMarket, url, type Post } from "@lib/content";
import { formatDate, latest } from "@lib/dates";
import { slugify } from "@lib/slugify";
import { readingTime } from "@lib/utils";
import { withLinks } from "@lib/links";
import { escapeHtml } from "@lib/linker.mjs";
import { coverFor, socialCard } from "@lib/covers";
import { blogPosting, breadcrumbList, faqPage, orgId, organization } from "@lib/schema";
import { inLang, langOf, marketMeta, ui } from "../i18n/ui";

const { post } = Astro.props as { post: Post };
const d = post.data;
const lang = langOf(post.id);
const market = postMarket(post);
const s = ui[lang];
const locale = marketMeta[market].intl;
const path = url.post(post.id);
const headings = post.rendered?.metadata?.headings ?? [];
const used = new Set<string>();
const body = await withLinks(post.rendered?.html ?? "", path, used);
const alternates = await postAlternates(post);
const mainCategory = d.categories[0];
const title = d.seoTitle ?? d.title;
const checklist = await getChecklist(d.checklist);
const clauseHtml = new Map<string, string>();
for (const sec of checklist?.data.sections ?? []) for (const it of sec.items) if (it[2] && !clauseHtml.has(it[2])) clauseHtml.set(it[2], await withLinks(escapeHtml(it[2]), path, used));
const image = d.coverImage ?? coverFor(d.cover);
const og = await socialCard(image);
const crumbs = lang === "en"
  ? [{ label: s.home, href: "/" }, { label: marketMeta[market].name, href: url.market(market) }, { label: s.hubGuides, href: url.guidesHub(market) }, { label: d.title, href: path }]
  : [{ label: s.home, href: inLang("/", lang) }, { label: s.hubGuides, href: url.guidesHub(market) }, { label: d.title, href: path }];
const dataAsOf = d.dataAsOf ?? latest(d.date, d.updated);
const meta = [formatDate(d.date, locale), ...(d.updated ? [`${s.updated} ${formatDate(d.updated, locale)}`] : []), s.minRead(readingTime(post.body ?? ""))];
const toc = [{ depth: 2, slug: "key-takeaways", text: s.keyTakeaways }, ...headings, ...(checklist ? [{ depth: 2, slug: "checklist", text: s.checklist }] : []), ...(d.faq.length ? [{ depth: 2, slug: "faq", text: s.faq }] : []), { depth: 2, slug: "sources", text: s.sources }];
const showTags = market === "us" || market === "fr" || market === "de";
---

<Layout notes={false} title={title} description={d.description} published={d.date} updated={latest(d.date, d.updated)} type="article" noindex={d.noindex} alternates={alternates} image={og}
  jsonLd={[
    blogPosting({ path, title: d.title, description: d.description, image: og, date: d.date, updated: d.updated, keywords: [d.keyword, ...d.tags], section: categoryName(mainCategory, lang), lang: marketMeta[market].hreflang }),
    breadcrumbList(crumbs),
    ...(d.faq.length ? [faqPage(d.faq)] : []),
    { ...organization(), "@id": orgId },
  ]}>
  <ArticleFrame crumbs={crumbs} title={d.title} subtitle={d.subtitle} label={categoryName(mainCategory, lang)} image={image} alt={d.coverAlt} meta={meta} toc={toc}>
    <div slot="aside" class="flex flex-wrap gap-2">
      {(lang !== "en" || market === "us") && d.categories.map((c) => <a class="chip" href={url.category(c, lang)}>{categoryName(c, lang)}</a>)}
      {showTags && d.tags.map((t) => <a class="chip" href={url.tag(slugify(t), lang)}>{t}</a>)}
    </div>
    <article class="article" data-pagefind-body>
      <p data-answer class="lead">{d.summary}</p>
      {d.localRule && <p class="rounded-md border-l-4 border-safety bg-[#fff8e5] px-4 py-3 text-[15px]" data-local-rule><strong>{s.inMarket(marketMeta[market].name)}:</strong> {d.localRule}</p>}
      <h2 id="key-takeaways">{s.keyTakeaways}</h2>
      <ul>{d.keyTakeaways.map((k) => <li>{k}</li>)}</ul>
      <Fragment set:html={body} />
      {checklist && <ChecklistBlock checklist={checklist} linkify={(c) => clauseHtml.get(c) ?? c} />}
      {d.faq.length > 0 && (
        <>
          <h2 id="faq">{s.faq}</h2>
          {d.faq.map((f) => (<><h3>{f.question}</h3><p>{f.answer}</p></>))}
        </>
      )}
      <h2 id="sources">{s.sources}</h2>
      <ul>{d.sources.map((src) => <li><a href={src.url} rel="noopener">{src.title}</a></li>)}</ul>
      <PageNotes dataAsOf={dataAsOf} sources={d.sources} />
    </article>
  </ArticleFrame>
</Layout>
