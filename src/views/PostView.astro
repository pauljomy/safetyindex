---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import TableOfContents from "@components/TableOfContents.astro";
import PostNavigation from "@components/PostNavigation.astro";
import Chip from "@components/Chip.astro";
import Cover from "@components/Cover.astro";
import ChecklistBlock from "@components/ChecklistBlock.astro";
import PageNotes from "@components/PageNotes.astro";
import RelatedBlock from "@components/RelatedBlock.astro";
import { categoryName, getChecklist, getGuides, postAlternates, postMarket, url, type Post } from "@lib/content";
import { formatDate, latest } from "@lib/dates";
import { slugify } from "@lib/slugify";
import { readingTime } from "@lib/utils";
import { withLinks } from "@lib/links";
import { coverFor, socialCard } from "@lib/covers";
import { blogPosting, breadcrumbList, faqPage, orgId, organization } from "@lib/schema";
import { inLang, langOf, marketMeta, ui } from "../i18n/ui";

const { post } = Astro.props as { post: Post };
const d = post.data;
const lang = langOf(post.id);
const market = postMarket(post);
const s = ui[lang];
const locale = marketMeta[market].intl;
const path = url.post(post.id);
const headings = post.rendered?.metadata?.headings ?? [];
const used = new Set<string>();
const body = await withLinks(post.rendered?.html ?? "", path, used);
const alternates = await postAlternates(post);
const all = await getGuides(market);
const i = all.findIndex((p) => p.id === post.id);
const [prevPost, nextPost] = [all[i - 1], all[i + 1]];
const mainCategory = d.categories[0];
const title = d.seoTitle ?? d.title;
const checklist = await getChecklist(d.checklist);
// Social card: the featured image cropped to 1200×630 JPEG (what Facebook, LinkedIn and X expect).
const og = await socialCard(d.coverImage ?? coverFor(d.cover));
const crumbs = lang === "en"
  ? [{ label: s.home, href: "/" }, { label: marketMeta[market].name, href: url.market(market) }, { label: s.hubGuides, href: url.guidesHub(market) }, { label: d.title, href: path }]
  : [{ label: s.home, href: inLang("/", lang) }, { label: s.hubGuides, href: url.guidesHub(market) }, { label: d.title, href: path }];
const dataAsOf = d.dataAsOf ?? latest(d.date, d.updated);
---

<Layout notes={false}
  title={title}
  description={d.description}
  published={d.date}
  updated={latest(d.date, d.updated)}
  type="article"
  noindex={d.noindex}
  alternates={alternates}
  image={og}
  jsonLd={[
    blogPosting({ path, title: d.title, description: d.description, image: og, date: d.date, updated: d.updated, keywords: [d.keyword, ...d.tags], section: categoryName(mainCategory, lang), lang: marketMeta[market].hreflang }),
    breadcrumbList(crumbs),
    ...(d.faq.length ? [faqPage(d.faq)] : []),
    { ...organization(), "@id": orgId },
  ]}
>
  <Container>
    <Breadcrumbs crumbs={crumbs} />
    <div class="mb-10 space-y-1">
      <div class="animate flex flex-wrap items-center gap-1.5 text-sm">
        <time datetime={d.date.toISOString()}>{formatDate(d.date, locale)}</time>
        {d.updated && <span>• {s.updated} <time datetime={d.updated.toISOString()}>{formatDate(d.updated, locale)}</time></span>}
        <span>• {s.minRead(readingTime(post.body ?? ""))}</span>
      </div>
      <h1 class="animate text-3xl font-semibold text-black dark:text-white">{d.title}</h1>
      <p class="animate pt-1 text-lg">{d.subtitle}</p>
      <div class="animate flex flex-wrap gap-2 pt-1">
        {lang !== "en" || market === "us" ? d.categories.map((c) => <Chip href={url.category(c, lang)}>{categoryName(c, lang)}</Chip>) : null}
        {market === "us" || market === "fr" || market === "de" ? d.tags.map((t) => <Chip href={url.tag(slugify(t), lang)}>#{t}</Chip>) : null}
      </div>
    </div>
    <Cover image={d.coverImage} subject={d.cover} alt={d.coverAlt} />
    <article class="animate" data-pagefind-body>
      <p data-answer class="lead font-medium text-black dark:text-white">{d.summary}</p>
      {d.localRule && <p class="rounded-md border-l-4 border-amber-500 bg-amber-50 px-4 py-2 text-sm dark:bg-amber-950/30" data-local-rule><strong>{s.inMarket(marketMeta[market].name)}:</strong> {d.localRule}</p>}
      <h2>{s.keyTakeaways}</h2>
      <ul>{d.keyTakeaways.map((k) => <li>{k}</li>)}</ul>
      {headings.length > 2 && <TableOfContents headings={headings} />}
      <Fragment set:html={body} />
      {checklist && <ChecklistBlock checklist={checklist} />}
      {
        d.faq.length > 0 && (
          <>
            <h2>{s.faq}</h2>
            {d.faq.map((f) => (
              <>
                <h3>{f.question}</h3>
                <p>{f.answer}</p>
              </>
            ))}
          </>
        )
      }
      <h2>{s.sources}</h2>
      <ul>
        {d.sources.map((src) => <li><a href={src.url} rel="noopener">{src.title}</a></li>)}
      </ul>
      <PageNotes dataAsOf={dataAsOf} sources={d.sources} />
    </article>
    <RelatedBlock />
    <div class="mt-16" data-pagefind-ignore>
      <PostNavigation {prevPost} {nextPost} />
    </div>
  </Container>
</Layout>
