---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import Chip from "@components/Chip.astro";
import { getTags, hubAlternates, url } from "@lib/content";
import { latest } from "@lib/dates";
import { breadcrumbList } from "@lib/schema";
import { inLang, ui, type Lang } from "../i18n/ui";
import { site } from "../config/site.mjs";

/** `slug` set → one tag's page; unset → the index of all tags. */
const { lang, slug } = Astro.props as { lang: Lang; slug?: string };
const s = ui[lang];
const tags = await getTags(lang);
const tag = slug ? tags.find((t) => t.slug === slug)! : undefined;
const posts = tag ? tag.posts : [];
const updated = latest(site.updated, ...(tag ? posts : tags.flatMap((t) => t.posts)).map((p) => latest(p.data.date, p.data.updated)));
const crumbs = [{ label: s.home, href: inLang("/", lang) }, { label: s.tags, href: url.tags(lang) }, ...(tag ? [{ label: tag.name, href: url.tag(tag.slug, lang) }] : [])];
---

<Layout
  title={tag ? s.tagTitle(tag.name) : s.allTags}
  description={tag ? s.tagDescription(tag.name) : s.tagsDescription}
  updated={updated}
  alternates={tag ? undefined : hubAlternates("/tags")}
  jsonLd={[breadcrumbList(crumbs)]}
>
  <Container>
    <div class="space-y-10" data-pagefind-ignore>
      {
        tag ? (
          <>
            <BackToPrevious href={url.tags(lang)}>{s.allTags}</BackToPrevious>
            <h1 class="animate font-semibold text-black dark:text-white">{s.postsTagged(tag.name)}</h1>
            <ul class="animate not-prose flex flex-col gap-4">{posts.map((p) => <li><ArrowCard entry={p} /></li>)}</ul>
          </>
        ) : (
          <>
            <h1 class="animate font-semibold text-black dark:text-white">{s.allTags}</h1>
            <div class="animate flex flex-wrap gap-2">
              {tags.map((t) => <Chip href={url.tag(t.slug, lang)}>{t.name} <span class="text-sm text-gray-600">({t.posts.length})</span></Chip>)}
            </div>
          </>
        )
      }
    </div>
  </Container>
</Layout>
