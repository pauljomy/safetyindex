---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import { categoryDescription, categoryName, getPosts, url } from "@lib/content";
import { latest } from "@lib/dates";
import { breadcrumbList } from "@lib/schema";
import { inLang, langs, ui, type Lang } from "../i18n/ui";
import { site } from "../config/site.mjs";

const { lang, slug } = Astro.props as { lang: Lang; slug: string };
const s = ui[lang];
const posts = (await getPosts(lang)).filter((p) => p.data.categories.includes(slug));
const name = categoryName(slug, lang);
// Hreflang only to languages whose version of this category page exists (has posts).
const present = [];
for (const l of langs) if ((await getPosts(l)).some((p) => p.data.categories.includes(slug))) present.push(l);
const alternates = present.length > 1 ? Object.fromEntries(present.map((l) => [l === "en" ? "us" : l, url.category(slug, l)])) : undefined;
---

<Layout
  title={s.categoryTitle(name)}
  description={categoryDescription(slug, lang).slice(0, 155)}
  updated={latest(site.updated, ...posts.map((p) => latest(p.data.date, p.data.updated)))}
  alternates={alternates}
  jsonLd={[breadcrumbList([{ label: s.home, href: inLang("/", lang) }, { label: s.categories, href: url.blog(lang) }, { label: name, href: url.category(slug, lang) }])]}
>
  <Container>
    <div class="space-y-10" data-pagefind-ignore>
      <BackToPrevious href={url.blog(lang)}>{s.backToBlog}</BackToPrevious>
      <div class="animate space-y-2">
        <h1 class="font-semibold text-black dark:text-white">{s.categoryTitle(name)}</h1>
        <p>{categoryDescription(slug, lang)}</p>
      </div>
      <ul class="animate not-prose flex flex-col gap-4">{posts.map((p) => <li><ArrowCard entry={p} /></li>)}</ul>
    </div>
  </Container>
</Layout>
