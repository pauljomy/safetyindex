---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { breadcrumbList } from "@lib/schema";
import { site } from "../config/site.mjs";
import PageBand from "@components/PageBand.astro";
---

<Layout
  title="Contact"
  description="How to reach Safety Index: report a mistake in a guide or ask a question by email."
  updated={new Date(site.updated)}
  jsonLd={[breadcrumbList([{ label: "Home", href: "/" }, { label: "Contact", href: "/contact" }])]}
>
  <PageBand crumbs={[{ label: "Home", href: "/" }, { label: "Contact", href: Astro.url.pathname }]} title={"Contact"} />
  <Container>
    <div class="article mt-12">
    <article data-pagefind-ignore>
      <p>Found a mistake, an out-of-date rule or a broken source link? Email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> with the page address and what is wrong. We correct confirmed errors and update the page date when the content changes.</p>
      <p>We cannot give individual legal or safety advice. For your own workplace, contact your regulator or a competent safety professional.</p>
    </article>
    </div>
  </Container>
</Layout>
