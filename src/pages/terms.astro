---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { breadcrumbList } from "@lib/schema";
import { site } from "../config/site.mjs";
---

<Layout
  title="Terms of use"
  description="The terms for using Safety First: general information only, not legal or professional advice, and no warranty."
  updated={new Date(site.updated)}
  jsonLd={[breadcrumbList([{ label: "Home", href: "/" }, { label: "Terms of use", href: "/terms" }])]}
>
  <Container>
    <h1 class="animate mb-6 text-2xl font-semibold text-black dark:text-white">Terms of use</h1>
    <article class="animate" data-pagefind-ignore>
      <p>Safety First publishes general workplace safety information. It is not legal, medical or professional advice, and it does not replace the regulations, standards and guidance of your own regulator.</p>
      <p>Guides are researched and written with AI and linked to primary sources (see <a href="/about#how-we-write">how we write</a>). We work to keep them accurate and current but give no warranty that they are complete, correct or suitable for your workplace. Rules differ by country, state and industry: check the source and ask your regulator or a competent safety professional before you rely on a guide.</p>
      <p>You may link to and quote our pages with attribution. Do not republish whole guides without permission.</p>
    </article>
  </Container>
</Layout>
