---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { breadcrumbList } from "@lib/schema";
import { site } from "../config/site.mjs";
import PageBand from "@components/PageBand.astro";
---

<Layout
  title="Terms of use"
  description="The terms for using Safety Index: general information only, not legal or professional advice, and no warranty."
  updated={new Date(site.updated)}
  jsonLd={[breadcrumbList([{ label: "Home", href: "/" }, { label: "Terms of use", href: "/terms" }])]}
>
  <PageBand crumbs={[{ label: "Home", href: "/" }, { label: "Terms of use", href: Astro.url.pathname }]} title={"Terms of use"} />
  <Container>
    <div class="article mt-12">
    <article data-pagefind-ignore>
      <p>Safety Index publishes general workplace safety information. It is not legal, medical or professional advice, and it does not replace the regulations, standards and guidance of your own regulator.</p>
      <p>Guides are researched and written with AI and linked to primary sources (see <a href="/about#how-we-write">how we write</a>). We work to keep them accurate and current but give no warranty that they are complete, correct or suitable for your workplace. Rules differ by country, state and industry: check the source and ask your regulator or a competent safety professional before you rely on a guide.</p>
      <p>You may link to and quote our pages with attribution. Do not republish whole guides without permission.</p>
    </article>
    </div>
  </Container>
</Layout>
