{
  "name": "safety-index-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build/postbuild.mjs && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && npm run build",
    "post": "node --env-file-if-exists=.env scripts/generate-post.mjs",
    "post:dry": "node --env-file-if-exists=.env scripts/generate-post.mjs --dry-run",
    "indexnow": "node scripts/indexnow.mjs",
    "cover": "node --env-file-if-exists=.env scripts/add-cover.mjs",
    "downloads": "node scripts/downloads/build.mjs",
    "downloads:verify": "node scripts/downloads/verify.mjs",
    "engine": "node --env-file-if-exists=.env scripts/engine/run.mjs",
    "engine:status": "node scripts/engine/status.mjs",
    "build:preview": "PREVIEW_ALL=1 astro build && node scripts/build/postbuild.mjs",
    "covers": "node --env-file-if-exists=.env scripts/covers.mjs",
    "release": "node scripts/release/release.mjs",
    "lighthouse": "node scripts/checks/lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/rss": "^4.0.18",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@tailwindcss/vite": "^4.1.13",
    "astro": "^6.1.3",
    "astro-pagefind": "^1.8.5",
    "clsx": "^2.1.1",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "latest",
    "@tailwindcss/typography": "^0.5.18",
    "exceljs": "^4.4.0",
    "lighthouse": "^12.8.2",
    "pagefind": "^1.4.0",
    "sharp": "^0.34.0",
    "yaml": "^2.8.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
