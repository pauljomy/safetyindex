// Cloudflare Workers config: safetyindex.blog is a static site, so the Worker
// only serves the built files in dist/ (no server code).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safetyindex",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // /about serves about.html, and /about.html redirects to /about.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
