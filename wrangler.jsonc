// Cloudflare Workers config: safetyindex.blog is a static site. The Worker (worker/index.js) only runs
// for requests that don't match a built file: lowercase redirects, 410s and the analytics endpoint /e.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safetyindex",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /about serves about.html, and /about.html redirects to /about.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
  // Cookie-free event counts (downloads, app button taps, store clicks), per market, go to Workers Analytics
  // Engine. It must be enabled on the Cloudflare account first (deploys fail with code 10089 otherwise). Once it
  // is (Workers & Pages → Analytics Engine), uncomment the next line; until then worker/index.js skips the write.
  // "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "safetyindex_events" }]
}
